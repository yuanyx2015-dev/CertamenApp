{
  "expo": {
    "name": "CertamenPrep",
    "slug": "certamenapp",
    "version": "1.1.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#f5efe3"
    },
    "scheme": "certamenapp",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ziyouyuan.certamenapp",
      "usesAppleSignIn": true,
      "icon": "./assets/icon.png",
      "buildNumber": "3",
      "entitlements": {
        "com.apple.developer.applesignin": ["Default"]
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "primaryCategory": "EDUCATION",
    "plugins": ["expo-web-browser", "expo-apple-authentication"],
    "android": {
      "package": "com.ziyouyuan.certamenapp",
      "icon": "./assets/icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#45121c"
      },
      "versionCode": 5
    },
    "extra": {
      "eas": {
        "projectId": "94b7d258-bd01-4749-817f-c13a3e8a184c"
      }
    }
  }
}
